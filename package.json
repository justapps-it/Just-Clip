{
  "name": "justclip",
  "version": "0.1.0",
  "private": true,
  "description": "Automatic clips from Twitch and YouTube streams, made in your browser. By justapps.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "release:android": "node scripts/release-android.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
